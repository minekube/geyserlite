+    /**
+     * Emits one machine-readable line for a Bedrock version refusal.
+     *
+     * <p>Only the two refusal paths above call this, so operators can count
+     * refused joins (and label them by the refused client protocol) instead of
+     * grepping for the player-visible disconnect text. The line deliberately
+     * carries no player identity: the client has not authenticated yet, and
+     * {@code bedrock_ingress} is the configured listener the refusal arrived
+     * on, never a client address.
+     */
+    private void logVersionRefusal(int protocolVersion, String refusal) {
+        geyser.getLogger().info("GEYSERLITE_REFUSAL refusal=" + refusal
+            + " client_protocol=" + protocolVersion
+            + " max_supported_protocol=" + GameProtocol.DEFAULT_BEDROCK_PROTOCOL
+            + " bedrock_ingress=" + geyser.config().bedrock().address() + ":" + geyser.config().bedrock().port());
+    }
