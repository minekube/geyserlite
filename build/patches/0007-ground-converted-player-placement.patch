+/**
+ * Resolves whether a converted player is standing on something, and where the nearest surface below
+ * it is.
+ * <p>
+ * This exists for one defect: a Bedrock client that has no terrain under it (chunk still loading, or a
+ * placement carried across a server hand-over) reports a fixed position in the air with no vertical
+ * motion. A Java client cannot produce that state, and the Java backend reads it as flight - Paper's
+ * {@code ServerGamePacketListenerImpl} latches {@code clientIsFloating} when the client says "not on
+ * ground", is not descending ({@code dy >= -0.03125}) and has no block within 1/16 around the body or
+ * 0.55 below the feet, then disconnects with {@code multiplayer.disconnect.flying} after 81 ticks
+ * (~4.05 s). For a converted player the position - not the ground flag - is what has to change, so we
+ * need the world's own answer to "is there ground here".
+ */
+public final class PlacementGrounding {
+
+    /**
+     * Depth below the feet that the Java server treats as "standing on a block" (Paper's
+     * {@code noBlocksAround} distance).
+     */
+    public static final double SUPPORT_DEPTH = 0.55;
+
+    /**
+     * How far below the feet a surface is still considered the player's placement, instead of a
+     * different floor entirely, for a session that is already playing.
+     */
+    public static final int MAX_GROUND_SEARCH = 32;
+
+    /**
+     * How far below the feet a surface may be for a <i>pending placement</i> (initial spawn, server
+     * switch, respawn). The backend chose the position, so the world's own surface under it is the
+     * answer wherever it is in the column; with {@link #MAX_GROUND_SEARCH} a placement taken 42
+     * blocks above the ground would never be resolved. Bounded by the dimension's own height.
+     */
+    public static final int MAX_PLACEMENT_GROUND_SEARCH = 384;
+
+    private static final double PLAYER_HALF_WIDTH = 0.3;
+    private static final double PLAYER_HEIGHT = 1.8;
+
+    private PlacementGrounding() {
+    }
+
+    /**
+     * Java's floor semantics, explicitly: the block coordinates below can be negative and a truncating
+     * conversion would silently skip the block directly under the player's feet.
+     */
+    private static int floor(double value) {
+        return (int) Math.floor(value);
+    }
+
+    private static boolean collides(GeyserSession session, int x, int y, int z) {
+        return BlockUtils.getCollision(session.getGeyser().getWorldManager().getBlockAt(session, x, y, z)) != null;
+    }
+
+    /**
+     * @return true if a collidable block exists within {@link #SUPPORT_DEPTH} below the given feet
+     * position, i.e. the Java server would consider the player supported by the world
+     */
+    public static boolean hasSupport(GeyserSession session, Vector3d feet) {
+        int minX = floor(feet.getX() - PLAYER_HALF_WIDTH);
+        int maxX = floor(feet.getX() + PLAYER_HALF_WIDTH);
+        int minZ = floor(feet.getZ() - PLAYER_HALF_WIDTH);
+        int maxZ = floor(feet.getZ() + PLAYER_HALF_WIDTH);
+        int minY = floor(feet.getY() - SUPPORT_DEPTH);
+        int maxY = floor(feet.getY());
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                for (int y = minY; y <= maxY; y++) {
+                    if (collides(session, x, y, z)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * @return true if the player's own body volume overlaps a collidable block, i.e. the position is
+     * inside geometry rather than in the air above it
+     */
+    public static boolean intersectsCollidableBlock(GeyserSession session, Vector3d feet) {
+        int minX = floor(feet.getX() - PLAYER_HALF_WIDTH);
+        int maxX = floor(feet.getX() + PLAYER_HALF_WIDTH);
+        int minZ = floor(feet.getZ() - PLAYER_HALF_WIDTH);
+        int maxZ = floor(feet.getZ() + PLAYER_HALF_WIDTH);
+        int minY = floor(feet.getY());
+        int maxY = floor(feet.getY() + PLAYER_HEIGHT);
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                for (int y = minY; y <= maxY; y++) {
+                    if (collides(session, x, y, z)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * @return true if the player is suspended in the air: nothing to stand on within
+     * {@link #SUPPORT_DEPTH} below the feet and not embedded in geometry either
+     */
+    public static boolean isSuspended(GeyserSession session, Vector3d feet) {
+        return !hasSupport(session, feet) && !intersectsCollidableBlock(session, feet);
+    }
+
+    /**
+     * @return the same position when it is already supported by the world, otherwise the nearest
+     * standing position on a surface below it, or the original position when there is no surface to
+     * stand on at all
+     */
+    public static Vector3d groundPlacement(GeyserSession session, Vector3d position, boolean placement) {
+        if (!isSuspended(session, position)) {
+            return position;
+        }
+        Vector3d grounded = groundBelow(session, position, placement);
+        return grounded != null ? grounded : position;
+    }
+
+    /**
+     * Finds the nearest position on top of a collidable block below the given feet position, within
+     * the search depth and within the dimension's height.
+     *
+     * @return the grounded feet position in the same column, or null when there is no surface to
+     * stand on (void world, or the player is already at the dimension floor)
+     */
+    public static @Nullable Vector3d groundBelow(GeyserSession session, Vector3d feet, boolean placement) {
+        return groundBelow(session, feet,
+            placement ? MAX_PLACEMENT_GROUND_SEARCH : MAX_GROUND_SEARCH);
+    }
+
+    /**
+     * Finds the nearest position on top of a collidable block below the given feet position, within
+     * {@code maxSearchDepth} blocks and within the dimension's height.
+     *
+     * @return the grounded feet position in the same column, or null when there is no surface to
+     * stand on (void world, or the player is already at the dimension floor)
+     */
+    public static @Nullable Vector3d groundBelow(GeyserSession session, Vector3d feet, int maxSearchDepth) {
+        int x = floor(feet.getX());
+        int z = floor(feet.getZ());
+        int minY = Math.max(session.getBedrockDimension().minY(), floor(feet.getY()) - maxSearchDepth);
+
+        for (int y = floor(feet.getY()) - 1; y >= minY; y--) {
+            BlockCollision collision = BlockUtils.getCollision(
+                session.getGeyser().getWorldManager().getBlockAt(session, x, y, z));
+            if (collision == null) {
+                continue;
+            }
+
+            // Top of the highest collision box in this block - full blocks land the feet on y + 1,
+            // partial blocks (slabs, carpets, snow) on their actual surface height.
+            double top = y;
+            for (BoundingBox box : collision.getBoundingBoxes()) {
+                top = Math.max(top, y + box.getMiddleY() + (box.getSizeY() / 2.0));
+            }
+
+            Vector3d candidate = Vector3d.from(feet.getX(), top, feet.getZ());
+            if (hasSupport(session, candidate) && !intersectsCollidableBlock(session, candidate)) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+}
