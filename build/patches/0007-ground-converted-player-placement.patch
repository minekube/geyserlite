+import org.cloudburstmc.math.vector.Vector3d;
+import org.geysermc.geyser.level.physics.BoundingBox;
+import org.geysermc.geyser.translator.collision.BlockCollision;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * The placement rules that keep a converted Bedrock client out of Paper's flying kick. The interesting
+ * case is the third one: an unsupported position whose column the backend has not sent yet must be
+ * reported as {@link PlacementGrounding.Resolution#UNKNOWN}, never as a void placement - the shipped
+ * grounding treated both as "no surface" and forwarded the airborne sample, which is what armed the
+ * 81-tick counter in production.
+ */
+class PlacementGroundingTest {
+
+    private static final int DIMENSION_MIN_Y = -64;
+
+    /**
+     * A full block at the given y, standing surface at y + 1.
+     */
+    private static BlockCollision fullBlock() {
+        BlockCollision collision = mock(BlockCollision.class);
+        when(collision.getBoundingBoxes()).thenReturn(new BoundingBox[]{
+            new BoundingBox(Vector3d.from(0.5, 0.5, 0.5), 1.0, 1.0, 1.0)
+        });
+        return collision;
+    }
+
+    /**
+     * A bottom slab at the given y: half a block tall, surface at y + 0.5.
+     */
+    private static BlockCollision bottomSlab() {
+        BlockCollision collision = mock(BlockCollision.class);
+        when(collision.getBoundingBoxes()).thenReturn(new BoundingBox[]{
+            new BoundingBox(Vector3d.from(0.5, 0.25, 0.5), 1.0, 0.5, 1.0)
+        });
+        return collision;
+    }
+
+    /**
+     * A single flat floor: only blocks at {@code floorY} collide.
+     */
+    private static PlacementGrounding.CollisionLookup floorAt(int floorY) {
+        BlockCollision floor = fullBlock();
+        return (x, y, z) -> y == floorY ? floor : null;
+    }
+
+    @Test
+    void supportedPositionNeedsNoCorrection() {
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve(floorAt(-61), true, DIMENSION_MIN_Y,
+            Vector3d.from(0.5, -60.0, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.SUPPORTED, grounding.resolution());
+        assertEquals(-60.0, grounding.position().getY());
+    }
+
+    @Test
+    void suspendedPositionOverKnownTerrainIsGroundedOnTheSurface() {
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve(floorAt(-61), true, DIMENSION_MIN_Y,
+            Vector3d.from(0.5, -57.5, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.SURFACE, grounding.resolution());
+        assertNotNull(grounding.position());
+        assertEquals(-60.0, grounding.position().getY());
+        // Grounding only changes the height; the column is the player's own.
+        assertEquals(0.5, grounding.position().getX());
+        assertEquals(0.5, grounding.position().getZ());
+    }
+
+    @Test
+    void partialBlockSurfaceIsHonoured() {
+        BlockCollision slab = bottomSlab();
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve(
+            (x, y, z) -> y == -61 ? slab : null, true, DIMENSION_MIN_Y, Vector3d.from(0.5, -57.5, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.SURFACE, grounding.resolution());
+        assertEquals(-60.5, grounding.position().getY());
+    }
+
+    /**
+     * The regression this card is about: the converter has no chunk for the column, so every block
+     * lookup returns air. That is missing data, not a void world - it must not be resolved either way.
+     */
+    @Test
+    void columnWithoutBlockDataIsUnknownAndNeverGrounded() {
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve(floorAt(-61), false, DIMENSION_MIN_Y,
+            Vector3d.from(0.5, -57.5, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.UNKNOWN, grounding.resolution());
+        assertNull(grounding.position());
+    }
+
+    @Test
+    void knownColumnWithNothingToStandOnIsVoid() {
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve((x, y, z) -> null, true,
+            DIMENSION_MIN_Y, Vector3d.from(0.5, -57.5, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.VOID, grounding.resolution());
+        assertNull(grounding.position());
+    }
+
+    @Test
+    void unknownColumnIsLeftWhereTheBackendPlacedThePlayer() {
+        // An unknown column must stay exactly where the backend put the player instead of being guessed
+        // onto a surface the converter cannot see.
+        PlacementGrounding.Grounding grounding = PlacementGrounding.resolve((x, y, z) -> null, false,
+            DIMENSION_MIN_Y, Vector3d.from(0.5, -57.5, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.UNKNOWN, grounding.resolution());
+        assertNull(grounding.position());
+    }
+
+    /**
+     * A placement is the backend's own position - a spawn, a server switch, a respawn - so the surface
+     * under it counts even when it is farther down than the mid-session window. This is the behaviour
+     * released geyserlite has (kanban t_1e9c9090: a placement 42 blocks above the ground), and it must
+     * survive the rework that introduced {@link PlacementGrounding.Resolution#UNKNOWN}.
+     */
+    @Test
+    void pendingPlacementGroundsOnASurfaceBelowTheMidSessionWindow() {
+        PlacementGrounding.Grounding placement = PlacementGrounding.resolve(floorAt(60), true, DIMENSION_MIN_Y,
+            PlacementGrounding.MAX_PLACEMENT_GROUND_SEARCH, Vector3d.from(0.5, 103.0, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.SURFACE, placement.resolution());
+        assertEquals(61.0, placement.position().getY());
+    }
+
+    /**
+     * The same column while the player is already playing must not be mistaken for a placement: a
+     * settled session keeps the narrow window and leaves the player where they are.
+     */
+    @Test
+    void settledSessionKeepsTheNarrowWindow() {
+        PlacementGrounding.Grounding session = PlacementGrounding.resolve(floorAt(60), true, DIMENSION_MIN_Y,
+            PlacementGrounding.MAX_GROUND_SEARCH, Vector3d.from(0.5, 103.0, 0.5));
+
+        assertEquals(PlacementGrounding.Resolution.VOID, session.resolution());
+        assertNull(session.position());
+    }
