+    /**
+     * Stops a converted client from being reported to the Java backend as flying while it has nothing
+     * under it, and puts it back on the world's surface when it should be standing.
+     * <p>
+     * The condition is deliberately narrow: the client must report no support within 0.55 blocks below
+     * its feet <i>and</i> essentially no vertical motion (Paper's own "not descending" threshold,
+     * 0.03125) for {@link #SUSPENDED_SAMPLE_THRESHOLD} consecutive samples. A jumping, falling,
+     * swimming, climbing, riding or flying player never satisfies it, so nothing legitimate is pinned:
+     * only the state that a Bedrock client produces when it has no terrain under it (chunk still
+     * loading, or a placement carried across a server hand-over) is caught.
+     *
+     * @return true if this sample must not be forwarded
+     */
+    private static boolean groundSuspendedPlacement(GeyserSession session, SessionPlayerEntity entity,
+                                                    PlayerAuthInputPacket packet, boolean isOnGround,
+                                                    boolean hasVehicle, boolean onClimbableBlock) {
+        if (hasVehicle || session.isNoClip() || session.isFlying() || onClimbableBlock
+            || session.getGameMode() == GameMode.SPECTATOR || session.getGameMode() == GameMode.CREATIVE
+            || session.getCollisionManager().isPlayerTouchingWater()) {
+            session.setSuspendedAirborneSamples(0);
+            return false;
+        }
+
+        Vector3d feetPosition = packet.getPosition().down(VanillaEntities.PLAYER_ENTITY_OFFSET).toDouble();
+        if (session.isPlacementPending() && (isOnGround || PlacementGrounding.hasSupport(session, feetPosition))) {
+            // The converted player is standing on the world; the placement is settled.
+            session.setPlacementPending(false);
+        }
+        boolean suspended = !isOnGround
+            && Math.abs(packet.getDelta().getY()) <= VERTICAL_MOTION_EPSILON
+            && PlacementGrounding.isSuspended(session, feetPosition);
+
+        if (!suspended) {
+            session.setSuspendedAirborneSamples(0);
+            return false;
+        }
+
+        int samples = session.getSuspendedAirborneSamples() + 1;
+        session.setSuspendedAirborneSamples(samples);
+        if (samples < SUSPENDED_SAMPLE_THRESHOLD) {
+            return false;
+        }
+
+        // Log once per latch, not once per sample.
+        boolean firstSample = samples == SUSPENDED_SAMPLE_THRESHOLD;
+
+        Vector3d grounded = PlacementGrounding.groundBelow(session, feetPosition);
+        if (grounded == null) {
+            // No surface we can prove exists below the feet (void column, or the converted client's
+            // chunk data genuinely has no terrain there). Never freeze the player on a guess: the
+            // sample is forwarded as before and the next one with terrain under it is grounded.
+            if (firstSample) {
+                session.getGeyser().getLogger().debug("No surface to ground suspended converted position "
+                    + feetPosition + " - leaving the sample alone");
+            }
+            session.setSuspendedAirborneSamples(0);
+            return false;
+        }
+
+        if (Math.abs(grounded.getY() - feetPosition.getY()) <= 1.0E-4) {
+            // Already level with the surface below: supported, so nothing to correct.
+            session.setSuspendedAirborneSamples(0);
+            return false;
+        }
+
+        if (firstSample) {
+            session.getGeyser().getLogger().debug("Grounding suspended converted player at " + feetPosition
+                + " to " + grounded);
+        }
+        entity.moveAbsolute(grounded.toFloat(), entity.getYaw(), entity.getPitch(), false, true);
+        session.setUnconfirmedTeleport(new TeleportCache(session, grounded.toFloat(),
+            entity.getPitch(), entity.getYaw(), -1));
+        session.setSuspendedAirborneSamples(0);
+        return true;
+    }
