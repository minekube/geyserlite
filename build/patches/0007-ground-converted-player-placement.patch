+package org.geysermc.geyser.util;
+
+import org.checkerframework.checker.nullness.qual.Nullable;
+import org.cloudburstmc.math.vector.Vector3d;
+import org.geysermc.geyser.level.physics.BoundingBox;
+import org.geysermc.geyser.session.GeyserSession;
+import org.geysermc.geyser.translator.collision.BlockCollision;
+
+/**
+ * Resolves whether a converted player is standing on something, and where the nearest surface below
+ * it is.
+ * <p>
+ * This exists for one defect: a Bedrock client that has no terrain under it (chunk still loading, or a
+ * placement carried across a server hand-over) reports a fixed position in the air with no vertical
+ * motion. A Java client cannot produce that state, and the Java backend reads it as flight - Paper's
+ * {@code ServerGamePacketListenerImpl} latches {@code clientIsFloating} when the client says "not on
+ * ground", is not descending ({@code dy >= -0.03125}) and has no block within 1/16 around the body or
+ * 0.55 below the feet, then disconnects with {@code multiplayer.disconnect.flying} after 81 ticks
+ * (~4.05 s). For a converted player the position - not the ground flag - is what has to change, so we
+ * need the world's own answer to "is there ground here".
+ * <p>
+ * The answer has to distinguish three states, not two: <i>supported</i>, <i>supported by nothing</i>
+ * (a void column the world really has) and <b>unknown</b> - the backend has not sent the chunk for this
+ * column yet. Treating unknown as "nothing there" is what leaves the airborne sample on the wire, and
+ * with it Paper's counter running; see {@link Resolution#UNKNOWN}.
+ */
+public final class PlacementGrounding {
+
+    /**
+     * Depth below the feet that the Java server treats as "standing on a block" (Paper's
+     * {@code noBlocksAround} distance).
+     */
+    public static final double SUPPORT_DEPTH = 0.55;
+
+    /**
+     * How far below the feet a surface is still considered the player's placement, instead of a
+     * different floor entirely.
+     */
+    public static final int MAX_GROUND_SEARCH = 32;
+
+    /**
+     * How far below the feet a surface may be for a <i>pending placement</i> (initial spawn, server
+     * switch, respawn). The backend chose the position, so the world's own surface under it is the
+     * answer wherever it is in the column; with {@link #MAX_GROUND_SEARCH} a placement taken 42 blocks
+     * above the ground would never be resolved. Bounded by the dimension's own height.
+     */
+    public static final int MAX_PLACEMENT_GROUND_SEARCH = 384;
+
+    private static final double PLAYER_HALF_WIDTH = 0.3;
+    private static final double PLAYER_HEIGHT = 1.8;
+
+    /**
+     * What the converter can say about the world under a placement.
+     */
+    public enum Resolution {
+        /**
+         * The position is already supported (or the body is inside geometry): nothing to do.
+         */
+        SUPPORTED,
+        /**
+         * There is a provable surface below the feet; {@link Grounding#position()} is where the player
+         * would stand on it.
+         */
+        SURFACE,
+        /**
+         * The converter has no block data for this column yet (the backend has not sent the chunk), so
+         * whether there is ground here is <i>unknown</i>. Nothing may be concluded from the air that
+         * block lookups returned.
+         */
+        UNKNOWN,
+        /**
+         * Block data for this column is present and there is genuinely nothing to stand on within
+         * {@link #MAX_GROUND_SEARCH} blocks: a void or sky placement.
+         */
+        VOID
+    }
+
+    /**
+     * The result of resolving a placement, with the standing position when one was found.
+     */
+    public record Grounding(Resolution resolution, @Nullable Vector3d position) {
+    }
+
+    /**
+     * Block collision lookup, so the placement rules can be exercised without a live session (and
+     * without the lifecycle that loads the block registries).
+     */
+    @FunctionalInterface
+    public interface CollisionLookup {
+        /**
+         * @return the collision of the block at these coordinates, or null when the block does not
+         * collide (air, water, plants, ...)
+         */
+        @Nullable BlockCollision at(int x, int y, int z);
+    }
+
+    private PlacementGrounding() {
+    }
+
+    /**
+     * Java's floor semantics, explicitly: the block coordinates below can be negative and a truncating
+     * conversion would silently skip the block directly under the player's feet.
+     */
+    private static int floor(double value) {
+        return (int) Math.floor(value);
+    }
+
+    private static @Nullable BlockCollision collisionAt(GeyserSession session, int x, int y, int z) {
+        return BlockUtils.getCollision(session.getGeyser().getWorldManager().getBlockAt(session, x, y, z));
+    }
+
+    /**
+     * @return true if the converter holds block data for the column containing the given feet position
+     * and may therefore treat an air block as real air
+     */
+    public static boolean blockDataKnown(GeyserSession session, Vector3d feet) {
+        return session.getGeyser().getWorldManager().hasBlockData(session, floor(feet.getX()), floor(feet.getZ()));
+    }
+
+    /**
+     * Resolves the placement for a live session.
+     *
+     * @see #resolve(CollisionLookup, boolean, int, Vector3d)
+     */
+    public static Grounding resolve(GeyserSession session, Vector3d feet) {
+        return resolve(session, feet, MAX_GROUND_SEARCH);
+    }
+
+    /**
+     * Resolves the placement for a live session, searching {@code maxSearchDepth} blocks down.
+     * <p>
+     * A pending placement uses {@link #MAX_PLACEMENT_GROUND_SEARCH}: the backend put the player there,
+     * so the surface under it is the answer even when it is far below.
+     */
+    public static Grounding resolve(GeyserSession session, Vector3d feet, int maxSearchDepth) {
+        return resolve((x, y, z) -> collisionAt(session, x, y, z),
+            blockDataKnown(session, feet), session.getBedrockDimension().minY(), maxSearchDepth, feet);
+    }
+
+    /**
+     * Resolves what the world says about the given feet position.
+     *
+     * @param lookup         block collision lookup
+     * @param blockDataKnown whether the converter actually holds block data for this column; when it
+     *                       does not, an unsupported position is {@link Resolution#UNKNOWN} rather than
+     *                       a void placement
+     * @param dimensionMinY  the dimension's floor, to bound the search
+     * @param feet           feet position
+     */
+    public static Grounding resolve(CollisionLookup lookup, boolean blockDataKnown, int dimensionMinY, Vector3d feet) {
+        return resolve(lookup, blockDataKnown, dimensionMinY, MAX_GROUND_SEARCH, feet);
+    }
+
+    /**
+     * Resolves what the world says about the given feet position, searching {@code maxSearchDepth}
+     * blocks down for a surface.
+     */
+    public static Grounding resolve(CollisionLookup lookup, boolean blockDataKnown, int dimensionMinY,
+                                    int maxSearchDepth, Vector3d feet) {
+        if (hasSupport(lookup, feet) || intersectsCollidableBlock(lookup, feet)) {
+            return new Grounding(Resolution.SUPPORTED, feet);
+        }
+        if (!blockDataKnown) {
+            return new Grounding(Resolution.UNKNOWN, null);
+        }
+        Vector3d ground = groundBelow(lookup, dimensionMinY, maxSearchDepth, feet);
+        if (ground != null) {
+            return new Grounding(Resolution.SURFACE, ground);
+        }
+        return new Grounding(Resolution.VOID, null);
+    }
+
+    /**
+     * @return true if a collidable block exists within {@link #SUPPORT_DEPTH} below the given feet
+     * position, i.e. the Java server would consider the player supported by the world
+     */
+    public static boolean hasSupport(GeyserSession session, Vector3d feet) {
+        return hasSupport((x, y, z) -> collisionAt(session, x, y, z), feet);
+    }
+
+    private static boolean hasSupport(CollisionLookup lookup, Vector3d feet) {
+        int minX = floor(feet.getX() - PLAYER_HALF_WIDTH);
+        int maxX = floor(feet.getX() + PLAYER_HALF_WIDTH);
+        int minZ = floor(feet.getZ() - PLAYER_HALF_WIDTH);
+        int maxZ = floor(feet.getZ() + PLAYER_HALF_WIDTH);
+        int minY = floor(feet.getY() - SUPPORT_DEPTH);
+        int maxY = floor(feet.getY());
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                for (int y = minY; y <= maxY; y++) {
+                    if (lookup.at(x, y, z) != null) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * @return true if the player's own body volume overlaps a collidable block, i.e. the position is
+     * inside geometry rather than in the air above it
+     * <p>
+     * The body is tested against the blocks' own collision boxes, not against their block cells: a
+     * player standing on a slab has their feet inside the slab's cell, but touching its surface is not
+     * overlapping it.
+     */
+    public static boolean intersectsCollidableBlock(GeyserSession session, Vector3d feet) {
+        return intersectsCollidableBlock((x, y, z) -> collisionAt(session, x, y, z), feet);
+    }
+
+    private static boolean intersectsCollidableBlock(CollisionLookup lookup, Vector3d feet) {
+        int minX = floor(feet.getX() - PLAYER_HALF_WIDTH);
+        int maxX = floor(feet.getX() + PLAYER_HALF_WIDTH);
+        int minZ = floor(feet.getZ() - PLAYER_HALF_WIDTH);
+        int maxZ = floor(feet.getZ() + PLAYER_HALF_WIDTH);
+        int minY = floor(feet.getY());
+        int maxY = floor(feet.getY() + PLAYER_HEIGHT);
+
+        double bodyMinX = feet.getX() - PLAYER_HALF_WIDTH;
+        double bodyMaxX = feet.getX() + PLAYER_HALF_WIDTH;
+        double bodyMinY = feet.getY();
+        double bodyMaxY = feet.getY() + PLAYER_HEIGHT;
+        double bodyMinZ = feet.getZ() - PLAYER_HALF_WIDTH;
+        double bodyMaxZ = feet.getZ() + PLAYER_HALF_WIDTH;
+
+        for (int x = minX; x <= maxX; x++) {
+            for (int z = minZ; z <= maxZ; z++) {
+                for (int y = minY; y <= maxY; y++) {
+                    BlockCollision collision = lookup.at(x, y, z);
+                    if (collision == null) {
+                        continue;
+                    }
+                    for (BoundingBox box : collision.getBoundingBoxes()) {
+                        if (overlaps(box, x, y, z, bodyMinX, bodyMaxX, bodyMinY, bodyMaxY, bodyMinZ, bodyMaxZ)) {
+                            return true;
+                        }
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    /**
+     * @return true if the block-local collision box, translated to these block coordinates, overlaps the
+     * given volume with more than a surface touch
+     */
+    private static boolean overlaps(BoundingBox box, int blockX, int blockY, int blockZ,
+                                    double bodyMinX, double bodyMaxX, double bodyMinY, double bodyMaxY,
+                                    double bodyMinZ, double bodyMaxZ) {
+        double minX = blockX + box.getMiddleX() - (box.getSizeX() / 2.0);
+        double maxX = blockX + box.getMiddleX() + (box.getSizeX() / 2.0);
+        double minY = blockY + box.getMiddleY() - (box.getSizeY() / 2.0);
+        double maxY = blockY + box.getMiddleY() + (box.getSizeY() / 2.0);
+        double minZ = blockZ + box.getMiddleZ() - (box.getSizeZ() / 2.0);
+        double maxZ = blockZ + box.getMiddleZ() + (box.getSizeZ() / 2.0);
+
+        return minX < bodyMaxX && maxX > bodyMinX
+            && minY < bodyMaxY && maxY > bodyMinY
+            && minZ < bodyMaxZ && maxZ > bodyMinZ;
+    }
+
+    /**
+     * @return true if the player is suspended in the air: nothing to stand on within
+     * {@link #SUPPORT_DEPTH} below the feet and not embedded in geometry either
+     */
+    public static boolean isSuspended(GeyserSession session, Vector3d feet) {
+        return !hasSupport(session, feet) && !intersectsCollidableBlock(session, feet);
+    }
+
+    /**
+     * @return the same position when it is already supported by the world, otherwise the nearest
+     * standing position on a surface below it, or the original position when there is no surface to
+     * stand on at all (including when the converter has no data for the column yet)
+     * <p>
+     * This is the placement path (initial spawn, server switch, respawn), so the search covers the whole
+     * column the backend placed the player in - see {@link #MAX_PLACEMENT_GROUND_SEARCH}.
+     */
+    public static Vector3d groundPlacement(GeyserSession session, Vector3d position) {
+        Grounding grounding = resolve(session, position, MAX_PLACEMENT_GROUND_SEARCH);
+        if (grounding.resolution() != Resolution.SURFACE) {
+            return position;
+        }
+        return grounding.position();
+    }
+
+    /**
+     * Finds the nearest position on top of a collidable block below the given feet position, within
+     * {@link #MAX_GROUND_SEARCH} blocks and within the dimension's height.
+     *
+     * @return the grounded feet position in the same column, or null when there is no surface to
+     * stand on (void world, or the player is already at the dimension floor)
+     */
+    public static @Nullable Vector3d groundBelow(GeyserSession session, Vector3d feet) {
+        return groundBelow((x, y, z) -> collisionAt(session, x, y, z),
+            session.getBedrockDimension().minY(), MAX_GROUND_SEARCH, feet);
+    }
+
+    private static @Nullable Vector3d groundBelow(CollisionLookup lookup, int dimensionMinY,
+                                                 int maxSearchDepth, Vector3d feet) {
+        int x = floor(feet.getX());
+        int z = floor(feet.getZ());
+        int minY = Math.max(dimensionMinY, floor(feet.getY()) - maxSearchDepth);
+
+        for (int y = floor(feet.getY()) - 1; y >= minY; y--) {
+            BlockCollision collision = lookup.at(x, y, z);
+            if (collision == null) {
+                continue;
+            }
+
+            // Top of the highest collision box in this block - full blocks land the feet on y + 1,
+            // partial blocks (slabs, carpets, snow) on their actual surface height.
+            double top = y;
+            for (BoundingBox box : collision.getBoundingBoxes()) {
+                top = Math.max(top, y + box.getMiddleY() + (box.getSizeY() / 2.0));
+            }
+
+            Vector3d candidate = Vector3d.from(feet.getX(), top, feet.getZ());
+            if (hasSupport(lookup, candidate) && !intersectsCollidableBlock(lookup, candidate)) {
+                return candidate;
+            }
+        }
+        return null;
+    }
+}
