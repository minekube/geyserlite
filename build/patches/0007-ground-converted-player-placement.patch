+package org.geysermc.geyser.translator.protocol.bedrock.entity.player.input;
+
+import org.cloudburstmc.math.vector.Vector3d;
+import org.geysermc.geyser.translator.protocol.bedrock.entity.player.input.BedrockMovePlayer.SuspendedAction;
+import org.geysermc.geyser.util.PlacementGrounding;
+import org.geysermc.geyser.util.PlacementGrounding.Grounding;
+import org.geysermc.geyser.util.PlacementGrounding.Resolution;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+/**
+ * The rule that decides whether a converted Bedrock movement sample reaches the Java backend.
+ * <p>
+ * The failure this card fixes: a suspended, motionless sample was forwarded whenever the converter
+ * could not prove a surface, so the backend received "not on ground, not descending" and Paper's
+ * {@code clientIsFloating} counter started its 81-tick road to {@code multiplayer.disconnect.flying}.
+ * Every one of those samples must now be withheld ({@link SuspendedAction#HOLD}) until a surface can be
+ * proven; only a provable surface may be used to correct the placement
+ * ({@link SuspendedAction#GROUND}).
+ */
+class SuspendedPlacementTest {
+
+    private static final Vector3d FEET = Vector3d.from(0.5, -57.5, 0.5);
+    private static final int THRESHOLD = 10;
+
+    @Test
+    void sampleThatLooksGroundedIsForwarded() {
+        assertEquals(SuspendedAction.FORWARD, BedrockMovePlayer.decideSessionAction(false, 0, null, FEET));
+    }
+
+    /**
+     * The regression: no provable surface (chunk not received) must never forward the sample, not even
+     * on the first one - a single forwarded sample arms the backend's counter and silence afterwards does
+     * not disarm it.
+     */
+    @Test
+    void unprovableSuspensionIsHeldFromTheFirstSample() {
+        assertEquals(SuspendedAction.HOLD,
+            BedrockMovePlayer.decideSessionAction(true, 1, null, FEET));
+        assertEquals(SuspendedAction.HOLD,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD,
+                new Grounding(Resolution.UNKNOWN, null), FEET));
+    }
+
+    @Test
+    void voidPlacementIsHeldToo() {
+        assertEquals(SuspendedAction.HOLD,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD, new Grounding(Resolution.VOID, null), FEET));
+    }
+
+    @Test
+    void sustainedSuspensionOverAProvableSurfaceIsGrounded() {
+        Grounding surface = new Grounding(Resolution.SURFACE, Vector3d.from(0.5, -60.0, 0.5));
+
+        assertEquals(SuspendedAction.GROUND,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD, surface, FEET));
+    }
+
+    @Test
+    void apexSampleIsHeldButNeverGrounds() {
+        // One or two suspended samples (a jump apex) are dropped, not teleported on: the threshold keeps
+        // a real jump from being yanked to the floor.
+        Grounding surface = new Grounding(Resolution.SURFACE, Vector3d.from(0.5, -60.0, 0.5));
+
+        assertEquals(SuspendedAction.HOLD,
+            BedrockMovePlayer.decideSessionAction(true, 1, surface, FEET));
+        assertEquals(SuspendedAction.HOLD,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD - 1, null, FEET));
+    }
+
+    @Test
+    void supportedResolutionForwardsWithoutTeleporting() {
+        Grounding supported = new Grounding(Resolution.SUPPORTED, FEET);
+        assertEquals(SuspendedAction.FORWARD,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD, supported, FEET));
+
+        Grounding levelWithTheSurface = new Grounding(Resolution.SURFACE, FEET);
+        assertEquals(SuspendedAction.FORWARD,
+            BedrockMovePlayer.decideSessionAction(true, THRESHOLD, levelWithTheSurface, FEET));
+    }
+}
