+    @SuppressWarnings("ResultOfMethodCallIgnored")
+    private static byte[] requestSkinImageData(String imageUrl) throws IOException {
+        File imageFile = GeyserImpl.getInstance().getBootstrap().getConfigFolder().resolve("cache").resolve("images")
+                .resolve(UUID.nameUUIDFromBytes(imageUrl.getBytes()) + ".png").toFile();
+        SkinPngDecoder.Image image = null;
+
+        if (imageFile.exists()) {
+            try (InputStream stream = Files.newInputStream(imageFile.toPath())) {
+                GeyserImpl.getInstance().getLogger().debug("Reading cached image from file " + imageFile.getPath() + " for " + imageUrl);
+                image = SkinPngDecoder.decode(stream);
+                imageFile.setLastModified(System.currentTimeMillis());
+            } catch (IOException ignored) {
+                // Download a fresh copy below when the cache entry is unreadable.
+            }
+        }
+
+        if (image == null) {
+            byte[] png = downloadImageBytes(imageUrl);
+            image = SkinPngDecoder.decode(new ByteArrayInputStream(png));
+            GeyserImpl.getInstance().getLogger().debug("Downloaded " + imageUrl);
+
+            if (GeyserImpl.getInstance().config().advanced().cacheImages() > 0) {
+                imageFile.getParentFile().mkdirs();
+                if (SkinPngDecoder.writeCache(imageFile.toPath(), png, exception -> GeyserImpl.getInstance().getLogger()
+                        .warning("Failed to cache skin " + imageUrl + ": " + exception.getMessage()))) {
+                    GeyserImpl.getInstance().getLogger().debug("Writing cached skin to file " + imageFile.getPath() + " for " + imageUrl);
+                }
+            }
+        }
+
+        return prepareSkinImageData(image, imageUrl);
+    }
+
+    static byte[] prepareSkinImageData(SkinPngDecoder.Image image, String imageUrl) {
+        int height = image.height();
+        int width = image.width();
+        if (width != 64 || (height != 32 && height != 64)) {
+            throw new IllegalStateException("Discarding incorrectly sized (" + width + "x" + height + ") skin texture from " + imageUrl);
+        }
+
+        byte[] mask = height == 32 ? SKIN_MASK_LEGACY : SKIN_MASK;
+        return SkinPngDecoder.applyAlphaMask(image, mask);
+    }
+
+    private static byte[] downloadImageBytes(String imageUrl) throws IOException {
+        HttpURLConnection connection = (HttpURLConnection) new URL(imageUrl).openConnection();
+        connection.setRequestProperty("User-Agent", WebUtils.getUserAgent());
+        connection.setConnectTimeout(10000);
+        connection.setReadTimeout(10000);
+        try (InputStream stream = connection.getInputStream()) {
+            byte[] png = stream.readNBytes(SkinPngDecoder.MAX_ENCODED_BYTES + 1);
+            if (png.length > SkinPngDecoder.MAX_ENCODED_BYTES) {
+                throw new IOException("Skin PNG exceeds " + SkinPngDecoder.MAX_ENCODED_BYTES + " bytes");
+            }
+            return png;
+        } finally {
+            connection.disconnect();
+        }
+    }
